# Copie para deploy/.env (que o Git ignora) e preencha. NUNCA versione o .env.
# Uso: docker compose --env-file deploy/.env -f deploy/compose.yml up -d --build

# Senha do PostgreSQL interno.            openssl rand -hex 24
POSTGRES_PASSWORD=

# Chave AES-256 das variáveis dos projetos (32 bytes em base64). Guarde uma
# cópia fora da VM: sem ela os valores cifrados não voltam.   openssl rand -base64 32
COBOGO_SECRET_KEY=

# Token do endpoint de rotas do Traefik (24 caracteres ou mais).   openssl rand -hex 32
COBOGO_ROUTER_TOKEN=

# Origem pública do painel. O Traefik leva este host à API.
COBOGO_PUBLIC_URL=https://cobogo.ocnaibill.dev

# Padrão inicial do domínio das aplicações (o painel pode trocar depois).
COBOGO_APPS_DOMAIN=cobogo.dev
COBOGO_APPS_SCHEME=https

# Token do túnel gerenciado da Cloudflare; só no perfil "tunnel":
#   docker compose --env-file deploy/.env --profile tunnel -f deploy/compose.yml up -d
TUNNEL_TOKEN=
