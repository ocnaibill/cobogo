# Coletor de métricas do Cobogó (DEC-43). Contexto de build: a raiz do repositório.
#   docker build -f deploy/Dockerfile.collector -t cobogo-collector .
# Só lê o Docker, pelo proxy de leitura (DOCKER_HOST), e só escreve as amostras no
# banco, com o seu role. Não leva git nem nenhuma ferramenta.
FROM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/cobogo-collector ./cmd/collector

FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
RUN apk add --no-cache ca-certificates && adduser -D -H -u 10001 cobogo
COPY --from=build /out/cobogo-collector /usr/local/bin/cobogo-collector
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/cobogo-collector"]
