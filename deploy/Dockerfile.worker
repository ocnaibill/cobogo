# Worker do Cobogó (DEC-32). Contexto de build: a raiz do repositório.
#   docker build -f deploy/Dockerfile.worker -t cobogo-worker .
# Leva o git, que o worker usa para clonar os repositórios; fala com o Docker
# só pelo proxy filtrado (DOCKER_HOST), nunca pelo socket.
FROM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/cobogo-worker ./cmd/worker

FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
RUN apk add --no-cache git ca-certificates && adduser -D -H -u 10001 cobogo
COPY --from=build /out/cobogo-worker /usr/local/bin/cobogo-worker
# Sistema de arquivos somente leitura: o git e os clones usam /tmp (tmpfs).
ENV HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/cobogo-worker"]
