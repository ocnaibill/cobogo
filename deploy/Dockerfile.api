# API do Cobogó (DEC-32). Contexto de build: a raiz do repositório.
#   docker build -f deploy/Dockerfile.api -t cobogo-api .
FROM golang:1.26-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-mod=readonly
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN go build -trimpath -ldflags="-s -w" -o /out/cobogo-api ./cmd/api

FROM alpine:3.22@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
RUN adduser -D -H -u 10001 cobogo
COPY --from=build /out/cobogo-api /usr/local/bin/cobogo-api
USER 10001:10001
EXPOSE 8080 8081
ENTRYPOINT ["/usr/local/bin/cobogo-api"]
